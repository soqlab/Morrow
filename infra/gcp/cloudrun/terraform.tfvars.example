project_id  = "replace-me"
region      = "europe-west1"
name_prefix = "pq"

image = "europe-west1-docker.pkg.dev/replace-me/pqc-containers/backend:latest"

# First apply: keep false so Terraform only provisions infra + secret containers.
# After you manually add secret versions for OPENAI_API_KEY and MORROW_VAULT_MASTER_KEY,
# flip this to true and apply again.
deploy_runtime = false

openai_model = "gpt-4.1-mini"
auth_mode    = "jwt"
auth_required = true
auth_provider_name = "Auth0"
auth_login_url = ""
auth_logout_url = ""
auth_token_help = ""
auth_jwt_issuer = "https://YOUR_AUTH_DOMAIN/"
auth_jwt_audience = "YOUR_API_AUDIENCE"
auth_jwt_jwks_url = "https://YOUR_AUTH_DOMAIN/.well-known/jwks.json"
auth_jwt_algorithms = "RS256"
auth_user_id_claim = "sub"
auth_role_claim = "https://morrow.soqlab.com/role"
auth_org_id_claim = "https://morrow.soqlab.com/org_id"
cors_origins = "https://YOUR_APP_DOMAIN"
csp_value = "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://YOUR_APP_DOMAIN"
sentry_dsn = "https://CHANGE_ME@o0.ingest.sentry.io/0"

api_min_instances     = 0
api_max_instances     = 2
worker_instance_count = 1
beat_instance_count   = 1

cloud_sql_database_version = "POSTGRES_16"
cloud_sql_tier             = "db-custom-1-3840"
redis_tier                 = "BASIC"
redis_memory_size_gb       = 1
