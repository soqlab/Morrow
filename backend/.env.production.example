# Morrow production environment template for backend deployments.
# Copy values into your cloud secret manager or deployment variables. Do not commit real values.

PQC_ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
AUTO_MIGRATE=0
ENABLE_INPROCESS_SCHEDULER=0
PQC_MAIN_DB_BACKEND=postgres
PQC_SQLITE_STATE_PERSISTENT=1
PQC_API_REPLICA_COUNT=1
PQC_AUXILIARY_STATE_MIGRATED=0

PQC_ALLOWED_HOSTS=api.your-domain.com,app.your-domain.com,admin.your-domain.com
PQC_CORS_ALLOW_ALL=0
PQC_CORS_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com
PQC_CSP_ENABLED=1
PQC_CSP_VALUE=default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.your-domain.com

PQC_AUTH_MODE=jwt
PQC_AUTH_REQUIRED=1
PQC_DEFAULT_ROLE=viewer
PQC_AUTH_PROVIDER_NAME=Auth0
PQC_AUTH_LOGIN_URL=https://auth.your-domain.com/authorize?client_id=REPLACE_WITH_CLIENT_ID&response_type=token&audience=REPLACE_WITH_API_AUDIENCE&redirect_uri=https://app.your-domain.com/
PQC_AUTH_LOGOUT_URL=https://auth.your-domain.com/v2/logout?client_id=REPLACE_WITH_CLIENT_ID&returnTo=https://app.your-domain.com/
PQC_AUTH_TOKEN_HELP=Use SSO. Paste bearer tokens only for break-glass support workflows.
PQC_AUTH_JWT_ISSUER=https://auth.your-domain.com/
PQC_AUTH_JWT_AUDIENCE=REPLACE_WITH_API_AUDIENCE
PQC_AUTH_JWT_JWKS_URL=https://auth.your-domain.com/.well-known/jwks.json
PQC_AUTH_JWT_ALGORITHMS=RS256
PQC_AUTH_USER_ID_CLAIM=sub
PQC_AUTH_ROLE_CLAIM=https://your-domain.com/role
PQC_AUTH_ORG_ID_CLAIM=https://your-domain.com/org_id
PQC_AUTH_CLOCK_SKEW_SECONDS=60
PQC_AUTH_ISSUER_ENABLED=0
PQC_ALLOW_HS256_IN_PRODUCTION=0
PQC_ADMIN_EMAIL=admin@your-domain.com
PQC_ADMIN_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD

DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DB?sslmode=require
PQC_PRODUCT_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DB?sslmode=require
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
CELERY_BROKER_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/1?ssl_cert_reqs=required

PQC_VAULT_MASTER_KEY=REPLACE_WITH_FERNET_KEY
PQC_PLATFORM_ADMIN_KEY=REPLACE_WITH_48_BYTE_RANDOM_URLSAFE_SECRET
PQC_ALLOW_PLATFORM_KEY_QUERY=0
PQC_ALLOW_DEMO_IN_PRODUCTION=0
PQC_ALLOW_UNSAFE_PRODUCTION_STARTUP=0
PQC_AIRLOCK_SIGNING_KEY=REPLACE_WITH_64_HEX_RANDOM_SECRET
PQC_AIRLOCK_REQUIRE_AGENT_SIGNATURE=1
PQC_AIRLOCK_MAX_CLOCK_SKEW_SECONDS=600

PQC_TRAFFIC_MONITOR_ENABLED=1
PQC_TRAFFIC_PERSIST_TO_DB=1
PQC_TRAFFIC_EVENTS_MAX=5000
PQC_TRAFFIC_IP_MAX=2000
PQC_TRUST_PROXY_HEADERS=0

SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.your-domain.com:4317
OTEL_SERVICE_NAME=morrow
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# --- PQC Scout (AI analyst) -------------------------------------------------
# Model for the agent in services/ai_agent.py. Defaults to claude-opus-5.
# ANTHROPIC_AGENT_MODEL=claude-opus-5
# Thinking depth: low | medium | high | xhigh | max. Default high. Agentic
# tool-calling loops like this one are where xhigh earns its cost.
# ANTHROPIC_AGENT_EFFORT=high
# Output ceiling for one analyst turn. Must stay inside AGENT_TIMEOUT --
# requests to Anthropic are not streamed, so raise both together.
# ANTHROPIC_AGENT_MAX_TOKENS=16000
# AGENT_TIMEOUT=180

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://app.your-domain.com/auth/github/callback
PQC_SECRET_BACKEND=vault

# --- Auxiliary feature store ------------------------------------------------
# Which backend the ~66 auxiliary feature tables use: postgres | sqlite.
# Unset, it follows the core database. Separate on purpose -- the core tables can
# be on Postgres while auxiliary state is migrated module by module.
# See docs/FEATURE_STORE_POSTGRES_MIGRATION.md.
# Keep PQC_API_REPLICA_COUNT=1 until /platform/state/coverage reports no
# auxiliary tables holding rows.
# PQC_FEATURE_STORE_BACKEND=postgres

# Deployment contract: operator SSO is distinct from customer access-token verification.
# Supply actual values; do not enable shared-key break-glass to bypass SSO setup.
PQC_ADMIN_OIDC_ISSUER=https://auth.your-domain.com
PQC_ADMIN_OIDC_CLIENT_ID=REPLACE_WITH_OPERATOR_OIDC_CLIENT_ID
PQC_ADMIN_OIDC_CLIENT_SECRET=
PQC_ADMIN_OPERATOR_ROLES=admin@your-domain.com=owner
PQC_ADMIN_REQUIRE_MFA=1
PQC_ALLOW_BREAK_GLASS_KEY=0
PQC_LISTEN_ADDRESS=127.0.0.1

# Customer-hosted AI requires the platform itself to run in the customer environment.
PQC_AI_DEPLOYMENT_LOCATION=platform
PQC_AI_LOCAL_URL=
PQC_AI_LOCAL_MODEL=
PQC_AI_LOCAL_API_KEY=
PQC_PUBLIC_BASE_URL=https://app.your-domain.com
