# Morrow production environment template.
# Copy to .env.prod or cloud secret manager variables. Do not commit real values.
# Fill every REPLACE_WITH_* value before go-live.

# Runtime
MORROW_ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
AUTO_MIGRATE=0
ENABLE_INPROCESS_SCHEDULER=0
MORROW_MAIN_DB_BACKEND=postgres
MORROW_SQLITE_STATE_PERSISTENT=1
MORROW_API_REPLICA_COUNT=1
# Set to 1 only after /platform/state/coverage is clear and endpoint-level migration is complete.
MORROW_AUXILIARY_STATE_MIGRATED=0

# Public domains and browser security
MORROW_ALLOWED_HOSTS=api.your-domain.com,app.your-domain.com,admin.your-domain.com
MORROW_CORS_ALLOW_ALL=0
MORROW_CORS_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com
MORROW_CSP_ENABLED=1
MORROW_CSP_VALUE=default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.your-domain.com
MORROW_HSTS_MAX_AGE=63072000

# Authentication - production requires external JWT/SSO with RS256/JWKS
MORROW_AUTH_MODE=jwt
MORROW_AUTH_REQUIRED=1
MORROW_AUTH_PROVIDER_NAME=Auth0
MORROW_AUTH_LOGIN_URL=https://auth.your-domain.com/authorize?client_id=REPLACE_WITH_CLIENT_ID&response_type=token&audience=REPLACE_WITH_API_AUDIENCE&redirect_uri=https://app.your-domain.com/
MORROW_AUTH_LOGOUT_URL=https://auth.your-domain.com/v2/logout?client_id=REPLACE_WITH_CLIENT_ID&returnTo=https://app.your-domain.com/
MORROW_AUTH_TOKEN_HELP=Use SSO. Paste bearer tokens only for break-glass support workflows.
MORROW_AUTH_JWT_ISSUER=https://auth.your-domain.com/
MORROW_AUTH_JWT_AUDIENCE=REPLACE_WITH_API_AUDIENCE
MORROW_AUTH_JWT_JWKS_URL=https://auth.your-domain.com/.well-known/jwks.json
MORROW_AUTH_JWT_ALGORITHMS=RS256
MORROW_AUTH_USER_ID_CLAIM=sub
MORROW_AUTH_ROLE_CLAIM=https://your-domain.com/role
MORROW_AUTH_ORG_ID_CLAIM=https://your-domain.com/org_id
MORROW_AUTH_CLOCK_SKEW_SECONDS=60
MORROW_AUTH_ISSUER_ENABLED=0
MORROW_ALLOW_HS256_IN_PRODUCTION=0
MORROW_DEFAULT_ROLE=viewer

# Bootstrap admin only for first controlled deployment. Prefer SSO for ongoing access.
MORROW_ADMIN_EMAIL=admin@your-domain.com
MORROW_ADMIN_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD

# Managed Postgres. Use a least-privilege runtime role with no superuser and no BYPASSRLS.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DB?sslmode=require
MORROW_PRODUCT_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DB?sslmode=require

# Managed Redis. URLs must include a password. Required when more than one API replica runs: rate-limit
# counters (per organization and per IP) live here, so without it N replicas allow N times every limit.
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
CELERY_BROKER_URL=rediss://:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/1?ssl_cert_reqs=required

# Production secrets. Generate with scripts/new-prod-env.ps1, then move values to secret manager.
MORROW_VAULT_MASTER_KEY=REPLACE_WITH_FERNET_KEY
MORROW_PLATFORM_ADMIN_KEY=REPLACE_WITH_48_BYTE_RANDOM_URLSAFE_SECRET
# Ceiling for the shared MORROW_PLATFORM_ADMIN_KEY: owner | operator | support | auditor (default owner).
# A shared-key request without x-platform-admin-role runs as auditor; it must ask for a higher role,
# and can never exceed this ceiling. Lower it (e.g. auditor) once named operators are configured.
MORROW_PLATFORM_ADMIN_KEY_ROLE=owner
# Named platform operators (preferred over the shared key). JSON list; the role is bound to the key and
# every admin audit event records the operator name. Only the SHA-256 of each key is configured here.
# Create an entry with: cd backend && python -m services.platform_operators --name alice --role operator
# MORROW_PLATFORM_OPERATORS=[{"name":"alice","role":"owner","key_sha256":"REPLACE_WITH_64_HEX"},{"name":"bob","role":"support","key_sha256":"REPLACE_WITH_64_HEX"}]
# How long each replica caches the access-token revocation list (operator session revoke), in seconds.
MORROW_TOKEN_REVOCATION_CACHE_SECONDS=10
# How long a verified organization API key (Authorization: Bearer pq_...) is cached per replica.
# Revocation is immediate on the revoking replica and takes at most this long elsewhere.
MORROW_API_KEY_CACHE_SECONDS=15
# How long each replica caches maintenance-mode state before re-reading it, in seconds.
MORROW_MAINTENANCE_CACHE_SECONDS=5
MORROW_AIRLOCK_SIGNING_KEY=REPLACE_WITH_64_HEX_RANDOM_SECRET
MORROW_AIRLOCK_REQUIRE_AGENT_SIGNATURE=1
MORROW_AIRLOCK_MAX_CLOCK_SKEW_SECONDS=600
MORROW_ALLOW_PLATFORM_KEY_QUERY=0
# Keep 0. Demo Lab seeding (/demo/lab/seed) is local development only
# (MORROW_ENVIRONMENT=local, dev or test) and this flag never re-enables it.
MORROW_ALLOW_DEMO_IN_PRODUCTION=0
MORROW_ALLOW_UNSAFE_PRODUCTION_STARTUP=0

# Values written into generated artifacts (verifiable credentials, hybrid
# certificates, CI workflows, SARIF reports, incident templates). When a value
# is unset the artifact omits it instead of carrying a placeholder.
# Public URL of this deployment: links in generated CI workflows and SARIF, the
# credentials JSON-LD context, and the fallback did:web domain.
MORROW_PUBLIC_BASE_URL=https://app.your-domain.com
# did:web domain for issued credentials, e.g. app.your-domain.com
# (defaults to the MORROW_PUBLIC_BASE_URL host; unset both to omit the issuer).
# MORROW_DID_WEB_DOMAIN=app.your-domain.com
# Public status page linked from generated customer incident messages.
# MORROW_STATUS_PAGE_URL=https://status.your-domain.com
# OID for the hybrid-certificate post-quantum public-key extension, under your own IANA
# Private Enterprise Number: 1.3.6.1.4.1.<your PEN>.<n>. Unset = extension omitted.
# MORROW_PRIVATE_ENTERPRISE_OID=

# Admin traffic monitor. It stores metadata only; no bodies, query values, cookies, or auth headers.
MORROW_TRAFFIC_MONITOR_ENABLED=1
MORROW_TRAFFIC_PERSIST_TO_DB=1
MORROW_AUTH_LOG_RETENTION_DAYS=90
MORROW_TRAFFIC_RETENTION_DAYS=7
MORROW_TRAFFIC_EVENTS_MAX=5000
MORROW_TRAFFIC_IP_MAX=2000
# Set to 1 only behind a trusted proxy/load balancer that strips spoofed forwarding headers.
MORROW_TRUST_PROXY_HEADERS=0

# Observability
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.your-domain.com:4317
OTEL_SERVICE_NAME=morrow

# AI is optional and off per organization until an admin approves a destination.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# --- post-quantum Scout (AI analyst) -------------------------------------------------
# Model for the agent in services/ai_agent.py. Defaults to claude-opus-5.
# ANTHROPIC_AGENT_MODEL=claude-opus-5
# Thinking depth: low | medium | high | xhigh | max. Default high. Agentic
# tool-calling loops like this one are where xhigh earns its cost.
# ANTHROPIC_AGENT_EFFORT=high
# Output ceiling for one analyst turn. Must stay inside AGENT_TIMEOUT --
# requests to Anthropic are not streamed, so raise both together.
# ANTHROPIC_AGENT_MAX_TOKENS=16000
# AGENT_TIMEOUT=180

# === BEGIN: model provider layer (services/llm) ==============================
# Added with backend/services/llm/. Full reference: docs/AI_PROVIDERS.md.
# Set NONE of these and nothing changes: the assistant uses Anthropic when
# ANTHROPIC_API_KEY is set, otherwise OpenAI, otherwise the built-in answerer.
#
# Which adapter answers. One of:
#   anthropic | openai | azure-openai | gemini | openai-compatible | ollama
#   builtin   (deterministic rules over this workspace; no model call)
#   custom    (your own module; see MORROW_LLM_CUSTOM_MODULE below)
# Naming a gateway directly -- groq, openrouter, together, vllm, lmstudio,
# llamacpp -- selects the openai-compatible adapter and fills in its base URL.
# MORROW_LLM_PROVIDER=anthropic
#
# Model, endpoint and credential for the chosen provider.
# MORROW_LLM_MODEL=
# MORROW_LLM_BASE_URL=
# MORROW_LLM_API_KEY=
#
# Extra headers for a gateway: JSON object, or k=v,k=v. Host, Content-Type,
# Content-Length and the hop-by-hop headers are refused.
# MORROW_LLM_HEADERS={"HTTP-Referer":"https://app.your-domain.com"}
#
# Azure OpenAI: the model lives in the URL as a deployment, and api-version is
# required. MORROW_LLM_BASE_URL=https://<resource>.openai.azure.com
# MORROW_LLM_AZURE_DEPLOYMENT=
# MORROW_LLM_API_VERSION=2024-10-21
#
# Request shape and limits. Timeout is per request; retries cover rate limits,
# timeouts, connection failures and 5xx with 0.5s/1s/2s backoff. A bad key or
# an unknown model is never retried.
# MORROW_LLM_TEMPERATURE=0.1
# MORROW_LLM_MAX_TOKENS=3000
# MORROW_LLM_TIMEOUT=60
# MORROW_LLM_RETRIES=2
#
# Capability overrides. "OpenAI-compatible" says nothing about whether a given
# server implements tool calling, and whether Ollama can depends on the model
# you pulled -- so both declare tools OFF until you say otherwise. Without
# tools the assistant answers from stored evidence and says so in the answer.
# MORROW_LLM_TOOLS=1
# MORROW_LLM_STREAM=1
# MORROW_LLM_CONTEXT_WINDOW=
# Use the provider's streaming protocol on the wire. Delivery to the browser is
# gated either way, because a model's output is credential-scanned in full
# before any of it is released.
# MORROW_LLM_WIRE_STREAM=0
#
# Your prices, per million tokens. There is no built-in price table: unset
# means cost is reported as "unknown" rather than guessed from a stale figure.
# MORROW_LLM_PRICE_INPUT_PER_MTOK=
# MORROW_LLM_PRICE_OUTPUT_PER_MTOK=
#
# Bring your own model in code. Dotted import path of a module implementing the
# same interface; copy examples/custom_llm_provider.py. An organization cannot
# select this: it names Python this server imports.
# MORROW_LLM_PROVIDER=custom
# MORROW_LLM_CUSTOM_MODULE=my_package.my_provider
#
# Forbid every external model call for this deployment. The assistant answers
# from built-in rules and says so. No per-organization setting can override it.
# MORROW_LLM_DISABLED=1
#
# Customers who supply their own provider and key do it in the console
# (Data Control > 06 / Model provider). That key is sealed with
# MORROW_VAULT_MASTER_KEY and is never returned by any endpoint.
# === END: model provider layer ===============================================

# GitHub integration - optional until a customer authorizes it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://app.your-domain.com/auth/github/callback

# Secret backend - wire this to your real secret manager in deployment.
MORROW_SECRET_BACKEND=vault

# --- Auxiliary feature store ------------------------------------------------
# Which backend the ~66 auxiliary feature tables use: postgres | sqlite.
# Unset, it follows the core database. Separate on purpose -- the core tables can
# be on Postgres while auxiliary state is migrated module by module.
# See docs/FEATURE_STORE_POSTGRES_MIGRATION.md.
# Keep MORROW_API_REPLICA_COUNT=1 until /platform/state/coverage reports no
# auxiliary tables holding rows.
# MORROW_FEATURE_STORE_BACKEND=postgres

# --- Usage rollups and per-organization rate limits -------------------------
# Daily usage rollups keep 30d/90d request, sign-in and active-user trends after the
# raw journal rows expire (MORROW_TRAFFIC_RETENTION_DAYS). They run at start-up
# (backfill) and then every MORROW_USAGE_ROLLUP_INTERVAL_SECONDS in each API process.
# MORROW_USAGE_ROLLUPS_ENABLED=1
# MORROW_USAGE_ROLLUP_INTERVAL_SECONDS=3600
# MORROW_USAGE_ROLLUP_RETENTION_DAYS=400
# Key for the salted hashes of active user ids in platform_active_users_daily. Set a
# long random value and keep it stable; when unset it is derived from
# MORROW_VAULT_MASTER_KEY (or MORROW_AUTH_JWT_SECRET), and rotating that key restarts
# distinct-user counting.
# MORROW_USAGE_ACTOR_SALT=
#
# Per-organization limits from the admin portal (Access > Rate limits) are enforced for
# requests authenticated as the organization. Counters use Redis when REDIS_URL or
# CELERY_BROKER_URL is set, otherwise each process counts on its own.
# MORROW_ORG_RATE_LIMITS_ENABLED=1
# MORROW_ORG_RATE_LIMIT_CACHE_SECONDS=15
# Platform-wide defaults for organizations without a saved override (0 = none).
# MORROW_ORG_DEFAULT_API_CALLS_PER_MIN=0
# MORROW_ORG_DEFAULT_SCANS_PER_HOUR=0

# --- Vendor support "view as customer" (read-only) ---------------------------
# Support tokens are signed with MORROW_AUTH_JWT_SECRET (required; sessions answer 503 without it).
# Sessions last 5-60 minutes, launch codes are single-use for 60 seconds, and access is read-only
# and allow-listed (services/support_sessions.py). Customers can turn access off per organization.
# How long a replica may trust a cached session status before re-reading it. Capped at 5 seconds;
# a revoke is immediate on the replica that handled it.
# MORROW_SUPPORT_SESSION_CACHE_SECONDS=5

# --- Operator alert routing (Operations > Alert routing) ----------------------
# Platform notifications (SLA breaches, failed-login spikes, maintenance, go-live blockers,
# incidents, abuse, expiring keys, feedback, autopatches) are sent to channels configured in
# the admin portal. Slack/PagerDuty/webhook targets are encrypted with MORROW_VAULT_MASTER_KEY.
# MORROW_ALERT_DISPATCH_ENABLED=1
# MORROW_ALERT_DISPATCH_INTERVAL_SECONDS=60
# Re-send an item that is still open after this many hours.
# MORROW_ALERT_RENOTIFY_HOURS=24
# Per channel: at most MORROW_ALERT_RATE_CAP messages per MORROW_ALERT_RATE_WINDOW_MINUTES, then one digest.
# MORROW_ALERT_RATE_CAP=20
# MORROW_ALERT_RATE_WINDOW_MINUTES=10
# MORROW_ALERT_DELIVERY_RETENTION_DAYS=30
# The dispatcher computes the go-live gate in-process without any credential, so go-live blockers
# are alerted even when the shared MORROW_PLATFORM_ADMIN_KEY is disabled (break-glass only).
#
# Platform email (alert email channels and "Email the invite"). Links use MORROW_PUBLIC_BASE_URL.
# MORROW_SMTP_HOST=smtp.your-provider.com
# MORROW_SMTP_PORT=587
# MORROW_SMTP_USER=
# MORROW_SMTP_PASSWORD=
# MORROW_SMTP_FROM=alerts@your-domain.com
# MORROW_SMTP_STARTTLS=1
# Alternative to MORROW_SMTP_HOST: reuse the SMTP settings one organization saved via /notifications/config.
# MORROW_PLATFORM_SMTP_ORG_ID=

# These are the vendor's own registered details, never a friendly product name.
# Registered address. Newlines or semicolons separate the lines.
# Optional, printed when set.
# Business registration number (the BRN in Mauritius) and VAT/GST registration number. Most
# Optional bank details, printed when set.
# The line printed under the bank details.

#
# afterwards breaks the sequence your accountant already keeps. Scope "year" (the default) produces
# PREFIX2026-0001 and restarts each January; "global" produces PREFIX0001 and runs continuously.
# gap, and the allocation is transactional so two operators issuing at once cannot collide.
# points, so 1500 = 15% of the subtotal, rounded half up at the last minor unit.
# THE PLATFORM APPLIES THE RATE YOU SET AND DECIDES NOTHING: whether tax is due, at what rate, and
# Default payment terms for a customer whose own record sets none.
# Currency used when a customer's commercial record names none.

# the end customer and it registers for and remits VAT/GST worldwide. Its fee is roughly 5% + $0.50
# Seconds a delivery timestamp may be off by before it is refused as stale.
# Where a customer lands after paying (default: MORROW_PUBLIC_BASE_URL + /ui/#admin).

# is required. Plan catalogue: backend/config/plans.json.
# Secret or restricted key (sk_test_/rk_test_ for test mode, sk_live_/rk_live_ for live).
# Where the card provider's customer portal returns customers (default: MORROW_PUBLIC_BASE_URL + /ui/#admin).
# 1 = enforce plan entitlements (402 for features outside the edition; read-only after the grace
# period once a subscription is canceled or unpaid). Identical whichever way the customer pays.
# Keep 0 until plans.json matches your order forms.
# Days a canceled or unpaid subscription keeps write access before the workspace becomes read-only.
# Alternative plan catalogue path (defaults to backend/config/plans.json).

# --- Operator sign-in: SSO, MFA and break-glass (vendor admin portal) ---------------------------
# OpenID Connect (authorization code + PKCE) for vendor staff. The IdP app's redirect URI must be
# {MORROW_PUBLIC_BASE_URL}/vendor-admin/sso/callback. See docs/COMPLETE_DOCUMENTATION.md "Operator SSO, MFA and break-glass".
# MORROW_ADMIN_OIDC_ISSUER=https://your-org.okta.com
# MORROW_ADMIN_OIDC_CLIENT_ID=
# Leave empty for a public (PKCE-only) client.
# MORROW_ADMIN_OIDC_CLIENT_SECRET=
# MORROW_ADMIN_OIDC_REDIRECT_URI=https://morrow.example.com/vendor-admin/sso/callback
# Operator roster: email=role (owner | operator | support | auditor). Emails not listed are denied.
# MORROW_ADMIN_OPERATOR_ROLES=alice@example.com=owner,bob@example.com=operator
# Optional extra restriction on the email domain. With no roster, domain members get MORROW_ADMIN_OIDC_DOMAIN_ROLE.
# MORROW_ADMIN_OIDC_ALLOWED_DOMAINS=example.com
# MORROW_ADMIN_OIDC_DOMAIN_ROLE=auditor
# MORROW_ADMIN_OIDC_SCOPES=openid email profile
# Claim holding the email (Entra ID without an email claim: preferred_username).
# MORROW_ADMIN_OIDC_EMAIL_CLAIM=email
# Require email_verified=true in the ID token (set 0 only for a single-tenant Entra ID issuer).
# MORROW_ADMIN_OIDC_REQUIRE_EMAIL_VERIFIED=1
# Console sessions: absolute and idle lifetime in seconds.
# MORROW_ADMIN_SESSION_ABSOLUTE_SECONDS=28800
# MORROW_ADMIN_SESSION_IDLE_SECONDS=1800
# TOTP MFA. Defaults to on when MORROW_ENVIRONMENT is production or staging.
# MORROW_ADMIN_REQUIRE_MFA=1
# Destructive actions (purge, retention run, org-wide revoke, key rotation, plan change) need a code this recent.
# MORROW_ADMIN_STEP_UP_SECONDS=900
# Break-glass: in production/staging the shared MORROW_PLATFORM_ADMIN_KEY is refused unless this is 1.
# Every use is audited with severity high and raised as a critical notification. Keep it unset.
# MORROW_ALLOW_BREAK_GLASS_KEY=0
# Vault key rotation (scripts/rotate-vault-master-key.py) reads the new key from here for one run only.
# MORROW_VAULT_MASTER_KEY_NEW=

# Deployment contract: operator SSO is distinct from customer access-token verification.
# Supply actual values; do not enable shared-key break-glass to bypass SSO setup.
MORROW_ADMIN_OIDC_ISSUER=https://auth.your-domain.com
MORROW_ADMIN_OIDC_CLIENT_ID=REPLACE_WITH_OPERATOR_OIDC_CLIENT_ID
MORROW_ADMIN_OIDC_CLIENT_SECRET=
MORROW_ADMIN_OPERATOR_ROLES=admin@your-domain.com=owner
MORROW_ADMIN_REQUIRE_MFA=1
MORROW_ALLOW_BREAK_GLASS_KEY=0
MORROW_LISTEN_ADDRESS=127.0.0.1

# Customer-hosted AI requires the platform itself to run in the customer environment.
MORROW_AI_DEPLOYMENT_LOCATION=platform
MORROW_AI_LOCAL_URL=
MORROW_AI_LOCAL_MODEL=
MORROW_AI_LOCAL_API_KEY=

# ── Free public readiness check (/check) ─────────────────────────────────────
# The no-account checker. It reads public Certificate Transparency data and makes
# at most two TLS connections to the hostname a visitor types, on port 443.
# Read docs/PUBLIC_CHECKER.md before exposing it on a public address: you need
# terms, an acceptable-use policy, an abuse address and a privacy notice first.
# Off until the five prerequisites above exist. Set REDIS_URL as well, so every
# replica shares one budget rather than each enforcing its own.
MORROW_PUBLIC_CHECK_ENABLED=0
# Shown on the page as the abuse / opt-out address. Use a monitored mailbox.
MORROW_PUBLIC_CHECK_ABUSE_CONTACT=
# Domains never to contact, comma-separated. The opt-out table adds to this.
MORROW_PUBLIC_CHECK_OPTOUT_DOMAINS=
# Budgets. Defaults shown; lower them if your egress is shared or metered.
MORROW_PUBLIC_CHECK_CACHE_SECONDS=3600
MORROW_PUBLIC_CHECK_IP_LIMIT=10
MORROW_PUBLIC_CHECK_DOMAIN_LIMIT=4
MORROW_PUBLIC_CHECK_GLOBAL_LIMIT=240
# Salt for the requester-IP hash in the check log. Generated and stored if unset.
MORROW_PUBLIC_CHECK_IP_SALT=

# Trial requests (/trial -> POST /trial-request). A trial request is a once-ever action for a
# real person, so anything above a handful an hour from one address is a script. There is no
# captcha by design: public pages here make no third-party request.
MORROW_RATE_LIMIT_TRIAL_REQUEST=6/hour

# Trial caps, applied as an operator rate-limit override when a trial request is approved.
# 0 means no cap, which is the default so a self-hosted deployment behaves as it did before.
#
# paying one. These are written through the override path, which is always enforced.
MORROW_TRIAL_API_CALLS_PER_MIN=60
MORROW_TRIAL_SCANS_PER_HOUR=10
