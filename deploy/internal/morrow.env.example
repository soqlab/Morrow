# Morrow inside a company network. setup.sh copies this to morrow.env and fills in the
# generated secrets; edit the rest by hand. Nothing here points outside the company.

# ── Address ─────────────────────────────────────────────────────────────────────
# The name people type to reach Morrow. Also set SITE_ADDRESS in .env to the same name.
MORROW_PUBLIC_BASE_URL=https://morrow.corp.example
MORROW_ALLOWED_HOSTS=morrow.corp.example
MORROW_CORS_ORIGINS=https://morrow.corp.example
MORROW_TRUST_PROXY_HEADERS=1

# ── First administrator ─────────────────────────────────────────────────────────
# Created on first start, only while there are no accounts. Sign in with it, then invite
# colleagues from the console. Remove the password from this file afterwards if you like.
MORROW_ADMIN_EMAIL=security-admin@corp.example
MORROW_ADMIN_PASSWORD=

# ── Generated by setup.sh (keep MORROW_VAULT_MASTER_KEY in a password manager) ─
MORROW_AUTH_JWT_SECRET=
MORROW_VAULT_MASTER_KEY=
MORROW_AIRLOCK_SIGNING_KEY=

# ── Fixed for this kind of install ──────────────────────────────────────────────
MORROW_ENVIRONMENT=staging
MORROW_MAIN_DB_BACKEND=sqlite
MORROW_FEATURE_STORE_BACKEND=sqlite
MORROW_SCANNER_DB=/data/morrow.db
MORROW_DATA_DIR=/data
MORROW_AUTH_MODE=jwt
MORROW_AUTH_REQUIRED=1
MORROW_DEFAULT_ROLE=viewer
MORROW_AUTH_ISSUER_ENABLED=1
MORROW_AUTH_JWT_ALGORITHMS=HS256
MORROW_SIGNIN_SIMPLE=1
MORROW_CSP_ENABLED=1
MORROW_ALLOW_PLATFORM_KEY_QUERY=0
MORROW_ALLOW_BREAK_GLASS_KEY=0

# Scan anything on the company network: internal names and IP addresses. (Domain ownership
# checks use public DNS and exist for the shared hosted service; they stay off here.)
MORROW_SCAN_REQUIRE_VERIFIED_DOMAINS=0
MORROW_SELF_SIGNUP=0

# Connect the company's own GitLab, Gitea or GitHub Enterprise on internal addresses.
MORROW_CODE_HOSTS_ALLOW_PRIVATE=1

# Features that would call the internet stay off.
MORROW_PUBLIC_CHECK_ENABLED=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Optional: the AI assistant, on your own model inside your network ───────────
# Nothing leaves the network: prompts go only to the server named here.
# Ollama:
# MORROW_LLM_PROVIDER=ollama
# MORROW_LLM_BASE_URL=http://ollama.corp.example:11434
# MORROW_LLM_MODEL=llama3.1
# Or any OpenAI-compatible server (vLLM, LM Studio, llama.cpp):
# MORROW_LLM_PROVIDER=openai-compatible
# MORROW_LLM_BASE_URL=https://llm.corp.example/v1
# MORROW_LLM_MODEL=your-model
# MORROW_LLM_API_KEY=
# Without either, the assistant answers from stored evidence with no model at all:
MORROW_LLM_DISABLED=1

# ── Optional: the company's internal mail server (invitations, password resets) ──
# Without it, invitation links are shown in the console to copy and send yourself.
# MORROW_SMTP_HOST=mail.corp.example
# MORROW_SMTP_PORT=587
# MORROW_SMTP_USER=
# MORROW_SMTP_PASSWORD=
# MORROW_SMTP_FROM=morrow@corp.example
