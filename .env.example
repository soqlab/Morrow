# ─────────────────────────────────────────────────────────────────────────────
# Airlock Command / PQC Scanner — local development configuration
#
# Copy this file to backend/.env and edit. Nothing here is required: the server
# starts with no configuration at all, falls back to SQLite, and reports what is
# missing at GET /health/deep and in Administration -> Launch readiness.
#
#     cp .env.example backend/.env
#
# Every value below is a placeholder. Never commit a real one — backend/.env and
# every .env except *.example is git-ignored.
#
# For a production deployment use .env.prod.example instead. It is the hardened
# template: external SSO, managed Postgres and Redis, strict CSP, real secrets.
# This file is the opposite — the smallest thing that runs on a laptop.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# local | staging | production. "production" refuses to start if the auth and
# secret settings below are still at their insecure defaults.
PQC_ENVIRONMENT=local
HOST=127.0.0.1
PORT=8001

# ── Database ─────────────────────────────────────────────────────────────────
# sqlite needs nothing installed and is the default. Leave it alone until you
# actually need Postgres; the test suite and the whole console work on SQLite.
PQC_MAIN_DB_BACKEND=sqlite
# Where the SQLite file lives. Defaults to backend/pqc_scanner.db, or
# /data/pqc_scanner.db inside the container.
# PQC_SCANNER_DB=
#
# For Postgres instead, set the backend to "postgres" and both URLs. The compose
# file in this repo starts one on port 5433 with these exact credentials.
# PQC_MAIN_DB_BACKEND=postgres
# DATABASE_URL=postgresql://pqc:pqc@localhost:5433/pqc
# PQC_PRODUCT_DATABASE_URL=postgresql://pqc:pqc@localhost:5433/pqc
# Run migrations on startup. Convenient locally, never in production.
AUTO_MIGRATE=1

# ── Authentication ───────────────────────────────────────────────────────────
# headers mode trusts x-user-role on every request, so ANY caller can claim any
# role. That is fine on a laptop and unacceptable anywhere else. /health/deep
# warns about both of the next two lines on purpose — do not silence it.
PQC_AUTH_MODE=headers
PQC_AUTH_REQUIRED=0
PQC_DEFAULT_ROLE=admin
#
# For real login, switch to jwt and point at your identity provider. See
# .env.prod.example for the full JWKS/RS256 set.
# PQC_AUTH_MODE=jwt
# PQC_AUTH_REQUIRED=1
# PQC_AUTH_JWT_ISSUER=https://auth.example.com/
# PQC_AUTH_JWT_AUDIENCE=your-api-audience
# PQC_AUTH_JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# PQC_AUTH_JWT_ALGORITHMS=RS256
#
# The built-in issuer (local accounts, no external IdP). Needs a signing secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# PQC_AUTH_ISSUER_ENABLED=1
# PQC_AUTH_JWT_SECRET=

# ── Secrets at rest ──────────────────────────────────────────────────────────
# Fernet key that seals integration credentials (webhook URLs, cloud keys,
# PagerDuty routing keys) before they touch the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, the features that store third-party credentials refuse to save
# rather than writing them in the clear.
PQC_VAULT_MASTER_KEY=
# Set only while rotating; see scripts/rotate-vault-master-key.py.
# PQC_VAULT_MASTER_KEY_NEW=

# ── Operator portal ──────────────────────────────────────────────────────────
# Shared key for the vendor-side portal at /vendor-admin/. Any long random
# string; 32 characters minimum.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PQC_PLATFORM_ADMIN_KEY=
# Ceiling for that shared key: owner | operator | support | auditor.
PQC_PLATFORM_ADMIN_KEY_ROLE=owner
# Named operators are preferred over the shared key — the role binds to the key
# and every admin action is attributed. Only each key's SHA-256 goes here.
#   cd backend && python -m services.platform_operators --name alice --role operator
# PQC_PLATFORM_OPERATORS=[{"name":"alice","role":"owner","key_sha256":"..."}]
# Require TOTP enrolment for operator sessions. Off locally so the first login
# is not a dead end; on for anything reachable from a network.
PQC_ADMIN_REQUIRE_MFA=0

# ── AI assistant ─────────────────────────────────────────────────────────────
# Entirely optional. With no provider configured the assistant is disabled and
# every other feature works normally — the console says so rather than failing.
#
# The AI layer is provider-agnostic: anything speaking the OpenAI chat-completions
# shape works, including a model running on your own machine. See
# docs/AI_PROVIDERS.md for the adapter list, the exact variables each one needs,
# and how to add a new provider.
#
# Which adapter to use. One of:
#   anthropic | openai | azure-openai | gemini | openai-compatible | ollama
#   builtin   -- the offline rule engine: explains findings with no network call
#   custom    -- your own class, see PQC_LLM_CUSTOM_MODULE below
# Leave it unset and the platform picks a provider from whichever credential is
# present, falling back to "builtin". Nothing external is called without a key.
# PQC_LLM_PROVIDER=builtin
PQC_LLM_API_KEY=
PQC_LLM_MODEL=
# Override the endpoint for self-hosted or gateway deployments, e.g.
# http://localhost:11434 for Ollama, or an OpenAI-compatible proxy.
# PQC_LLM_BASE_URL=
# Azure OpenAI only: the deployment name, which is not the model name.
# PQC_LLM_AZURE_DEPLOYMENT=
# PQC_LLM_API_VERSION=
# Extra headers as JSON, for gateways that want their own auth.
# PQC_LLM_HEADERS={}
# Your own adapter: a module exposing a Provider subclass.
# PQC_LLM_CUSTOM_MODULE=my_package.my_adapter
PQC_LLM_TIMEOUT=60
# PQC_LLM_MAX_TOKENS=
# PQC_LLM_TEMPERATURE=
# PQC_LLM_RETRIES=2
# PQC_LLM_TOOLS=1
# PQC_LLM_STREAM=1
# Cost accounting for the usage report, in currency per million tokens.
# PQC_LLM_PRICE_INPUT_PER_MTOK=
# PQC_LLM_PRICE_OUTPUT_PER_MTOK=
#
# Hard off switch. With this set, no external model is called whatever else is
# configured, and the assistant falls back to the offline rule engine. Use it
# for a deployment that must never send data to a third party.
# PQC_LLM_DISABLED=1
#
# Legacy single-provider variables. Still honoured so existing setups keep
# working; prefer the PQC_LLM_* set above for anything new.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_AGENT_MODEL=

# ── Background work ──────────────────────────────────────────────────────────
# With no broker, scans run in-process. That works for a single node and is the
# default; it is not restart-safe, so a scan interrupted by a restart is lost.
# Point these at Redis to run them on a Celery worker instead.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# REDIS_PASSWORD=
#
# Redis also holds the rate-limit counters. Without it, N replicas each allow
# the full limit, so N replicas allow N times the limit. One replica is fine.
ENABLE_INPROCESS_SCHEDULER=1

# ── Browser security ─────────────────────────────────────────────────────────
# Wide open locally so the console loads from any origin you serve it on.
PQC_CORS_ALLOW_ALL=1
# PQC_ALLOWED_HOSTS=127.0.0.1,localhost
# PQC_CSP_ENABLED=0
# Absolute URL used in anything that leaves the process — emailed links, signed
# bundles, webhooks. Without it those fall back to the request's own origin,
# which is wrong behind a proxy.
# PQC_PUBLIC_BASE_URL=http://127.0.0.1:8001

# ── Scanning ─────────────────────────────────────────────────────────────────
# Per-target timeout in seconds for the TLS and certificate probes.
PER_TARGET_TIMEOUT=20
# Repository correlation against GitHub. Read-only scope is enough.
# GITHUB_TOKEN=

# ── Integrations (all optional) ──────────────────────────────────────────────
#
# Outbound email. Without it the platform logs the message instead of sending.
# PQC_SMTP_HOST=
# PQC_SMTP_FROM=
#
# Error reporting. Unset means exceptions stay in the log.
# SENTRY_DSN=

# ── Tests ────────────────────────────────────────────────────────────────────
# The suite runs with none of these set: tests needing a real service skip.
# Set them to make those tests run instead of skip.
# PQC_TEST_PG_DSN=postgresql://pqc:pqc@localhost:5433/pqc
# PQC_TEST_REDIS_URL=redis://localhost:6379/1

# ── Free public readiness check (/check) ─────────────────────────────────────
# The no-account checker. It reads public Certificate Transparency data and makes
# at most two TLS connections to the hostname a visitor types, on port 443.
# Read docs/PUBLIC_CHECKER.md before exposing it on a public address: you need
# terms, an acceptable-use policy, an abuse address and a privacy notice first.
PQC_PUBLIC_CHECK_ENABLED=1
# Shown on the page as the abuse / opt-out address. Use a monitored mailbox.
PQC_PUBLIC_CHECK_ABUSE_CONTACT=
# Domains never to contact, comma-separated. The opt-out table adds to this.
PQC_PUBLIC_CHECK_OPTOUT_DOMAINS=
# Budgets. Defaults shown; lower them if your egress is shared or metered.
PQC_PUBLIC_CHECK_CACHE_SECONDS=3600
PQC_PUBLIC_CHECK_IP_LIMIT=10
PQC_PUBLIC_CHECK_DOMAIN_LIMIT=4
PQC_PUBLIC_CHECK_GLOBAL_LIMIT=240
# Salt for the requester-IP hash in the check log. Generated and stored if unset.
PQC_PUBLIC_CHECK_IP_SALT=

# Trial requests (/trial -> POST /trial-request). A trial request is a once-ever action for a
# real person, so anything above a handful an hour from one address is a script. There is no
# captcha by design: public pages here make no third-party request.
PQC_RATE_LIMIT_TRIAL_REQUEST=6/hour

# Trial caps, applied as an operator rate-limit override when a trial request is approved.
# 0 means no cap, which is the default so a self-hosted deployment behaves as it did before.
#
# paying one. These are written through the override path, which is always enforced.
PQC_TRIAL_API_CALLS_PER_MIN=0
PQC_TRIAL_SCANS_PER_HOUR=0
